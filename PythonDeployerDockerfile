# Stage 1: Build stage
# Using a slim Python image to keep the build environment lightweight.
FROM python:3.11-slim as builder

# Set the working directory inside the container.
WORKDIR /app

# Install build dependencies. Poetry is used for robust dependency management.
RUN pip install --no-cache-dir poetry

# Copy only the dependency definition files to leverage Docker's layer caching.
# This ensures that we don't reinstall dependencies unless they have changed.
COPY poetry.lock pyproject.toml ./

# Configure poetry to not create a virtual environment, and install dependencies
# into the system's site-packages. This is standard practice for containerization.
# --no-dev excludes development dependencies like pytest, keeping the image lean.
# --no-interaction and --no-ansi are for non-interactive CI/CD environments.
RUN poetry config virtualenvs.create false && \
    poetry install --no-dev --no-interaction --no-ansi

# Copy the application source code into the container.
COPY . .

# Stage 2: Final production stage
# Use a slim base image to keep the final container size as small as possible.
FROM python:3.11-slim

# Set the working directory for the application.
WORKDIR /app

# Copy the pre-installed dependencies from the builder stage.
# This avoids the need to have build tools like poetry in the final production image.
COPY --from=builder /app /app

# Install Gunicorn, a production-grade WSGI server for Python applications.
RUN pip install --no-cache-dir gunicorn

# Expose the port that Gunicorn will run on.
EXPOSE 8000

# The command to run the application using Gunicorn.
# -w 4 specifies 4 worker processes for handling concurrent requests.
# -k uvicorn.workers.UvicornWorker uses Uvicorn's worker class for high-performance async capabilities.
# main:app points to the FastAPI app instance located in the main.py file.
# --bind 0.0.0.0:8000 makes the server accessible from outside the container.
CMD ["gunicorn", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "main:app", "--bind", "0.0.0.0:8000"]